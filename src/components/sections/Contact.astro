---
import Brand from '../layout/Brand.astro';
import { whatsappUrl } from '../../lib/whatsapp';
import { company } from '../../data/company';
---
<section class="contact section-pad" id="contato" aria-labelledby="contact-title"><div class="shell"><p class="eyebrow">04 / SUA VEZ</p><h2 id="contact-title" class="contact-title reveal">Vamos dar forma<br /><em>à sua ideia?</em></h2><div class="contact-row"><p>Conte o que você imagina. A conversa começa por aqui.</p><a class="contact-button" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Conversar sobre meu projeto <span aria-hidden="true">↗</span></a></div><footer class="footer"><a href="#topo" aria-label="Artesanal — voltar ao início"><Brand /></a><span>{company.city}</span><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><span>© {new Date().getFullYear()} Artesanal</span></footer></div></section>
