---
import Brand from './Brand.astro';
import { whatsappUrl } from '../../lib/whatsapp';
---
<header class="site-header" id="topo">
  <a href="#topo" aria-label="Artesanal — início"><Brand /></a>
  <nav class="desktop-nav" aria-label="Navegação principal"><a href="#essencia">Essência</a><a href="#portfolio">Portfólio</a><a href="#processo">Processo</a></nav>
  <a class="header-cta" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Iniciar um projeto <span aria-hidden="true">↗</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menu"><span></span><span></span></button>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Navegação mobile" hidden><a href="#essencia">Essência</a><a href="#portfolio">Portfólio</a><a href="#processo">Processo</a><a href="#contato">Contato</a></nav>
</header>
